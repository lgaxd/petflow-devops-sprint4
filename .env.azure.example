# Copie para .env.azure (ignorado pelo Git) e preencha. Os scripts em scripts/ leem este arquivo.
# Use aspas simples em valores com caracteres especiais, mas evite aspas simples (') nas senhas.
# Infra NOVA e separada da disciplina de Java (que usa 561413-petflow-rg / -webapp / -front).

# Regiões permitidas pela política da assinatura Azure for Students: southafricanorth, spaincentral,
# southcentralus, eastus, chilecentral. Para o PostgreSQL Flexible Server, southcentralus e eastus estão
# RESTRITAS ('Subscriptions are restricted from provisioning in this region'). Use southafricanorth
# (também tem App Service B1), ou spaincentral / chilecentral.
LOCATION=southafricanorth
RESOURCE_GROUP=561413-petflow-s4-devops-rg
APP_SERVICE_PLAN=561413-petflow-s4-plan
WEB_APP_NAME=561413-petflow-s4-api

# Nome do servidor PostgreSQL (único na Azure) e do banco
PG_SERVER_NAME=561413-petflow-s4-pg
PG_DATABASE=petflow

# Administrador do servidor: usado só pelo script 01 (a API NÃO usa)
PG_ADMIN_USER=pgadmin
PG_ADMIN_PASSWORD=

# Usuário do banco usado pela aplicação (criado pelo script 01)
DB_USERNAME=petflow_user
DB_PASSWORD=

# Chave dos tokens JWT, 32+ caracteres (ex.: openssl rand -base64 32)
JWT_SECRET=

# Conta do seed (V2) usada pelo smoke test e pelo CRUD do vídeo
SMOKE_TUTOR_EMAIL=maria@petflow.com
SMOKE_TUTOR_PASSWORD=

# Opcional: seu IPv4 público para o firewall do PostgreSQL. Vazio = detectado automaticamente.
CLIENT_IP=
